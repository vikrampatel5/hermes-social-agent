# Hermes Social Engagement Agent - Environment Variables

Copy this file to `.env` and fill in your credentials.
Never commit `.env` to version control.

## Application

APP_ENV=development
DATABASE_URL=sqlite:///data/state.db
REDIS_URL=
LOG_LEVEL=INFO

## Autonomous Posting

AUTONOMOUS_POSTING_ENABLED=false
APPROVAL_REQUIRED=true
DRY_RUN=true

## Rate Limits

MAX_COMMENTS_PER_HOUR=5
MAX_COMMENTS_PER_DAY=20
CREATOR_COOLDOWN_HOURS=48
CONTENT_COOLDOWN_HOURS=24

## Scoring Thresholds

MIN_RELEVANCE_SCORE=75
MIN_COMMENT_VALUE_SCORE=70
MAX_SPAM_RISK_SCORE=20
DUPLICATE_SIMILARITY_THRESHOLD=0.85
CREATOR_QUALITY_MIN=50

## Strategy Weights

STRATEGY_WEIGHTS={"technical": 0.3, "educational": 0.25, "question": 0.15, "tool_mention": 0.1, "promotional": 0.05, "no_cta": 0.15}

## Platform APIs

YOUTUBE_API_KEY=your_youtube_api_key_here
INSTAGRAM_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
X_API_KEY=
X_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
LINKEDIN_API_KEY=
LINKEDIN_ACCESS_TOKEN=

## Website

WEBSITE_URL=https://stockscribe.in

## Kill Switches (set to true to activate)

GLOBAL_KILL_SWITCH=false
PLATFORM_KILL_SWITCH=false
CAMPAIGN_KILL_SWITCH=false
ACCOUNT_KILL_SWITCH=false

## Discovery

DISCOVERY_INTERVAL_MINUTES=60
ANALYSIS_INTERVAL_MINUTES=30
METRICS_INTERVAL_MINUTES=30
LEARNING_INTERVAL_HOURS=6

## Exploration vs Exploitation

EXPLORATION_RATE=0.1
EXPLOITATION_RATE=0.7
TEST_RATE=0.2